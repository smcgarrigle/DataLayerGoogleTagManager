# Copy to .env and fill in.  `docker compose` reads .env automatically.

# Port WordPress is published on. 80/8000/8080 are already taken on this host.
WP_PORT=8888

# Google Tag Manager web container, e.g. GTM-ABC1234.
# Leave blank to run the lab with no container at all — the on-page inspector
# still works, because it hooks dataLayer.push directly.
GTM_CONTAINER_ID=

# OPTIONAL and mutually exclusive with GTM in practice.
# If set, the lab loads gtag.js directly with debug_mode:true.
# Do NOT set this at the same time as GTM_CONTAINER_ID if your container also
# contains a GA4 config tag — you will double-count every single event.
GA4_MEASUREMENT_ID=

# OPTIONAL — GTM Environments. Lets localhost load your *Development* container
# version so you never have to publish to Live just to test.
# GTM → Admin → Environments → Actions → Get snippet, then copy the two query
# params out of the snippet it gives you.
GTM_ENV_AUTH=
GTM_ENV_PREVIEW=
